# This machine's agent files
.claude/

# Python
.venv/
__pycache__/
*.pyc

# Build output (tiles, OBJ, kn5 parts, previews, logs) and release zips
out/
dist/

# Settings of the generator page (the AC folder differs per machine)
settings.json

# User-imported materials and models (kept across updates, never part of a release)
library/

# Map data cache (elevation, map data, vegetation; several GB, downloaded again any time)
cache/

# CC0 textures from ambientCG (tools/get_textures.py downloads them)
assets/textures/

# Single preview images in the project folder
*_preview.png

# A downloaded update on its way in (src/app/updater.py, "Start Map2Lap.bat")
update/

# The Rust module's build folder (tools/build_native.py)
native/earthfast/target/
native/modelconvert/target/

# The Editor tab's packages (ui/: bun install)
ui/node_modules/
