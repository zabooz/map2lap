*.bat text eol=crlf
# (Linux reads these: a CR at a line's end breaks the shebang and every command)
*.sh text eol=lf
*.desktop text eol=lf
.githooks/* text eol=lf
# The snow helper's source receipt hashes these bytes on Windows and Linux.
native/snowworker/main.rs text eol=lf
tools/build_snow_worker.py text eol=lf
# Built bundles contain third-party shader strings; review their sources in ui/.
src/web/** -whitespace linguist-generated=true
# The native AC plugin's release receipt also hashes the checked-out sources.
native/acplugin/* text eol=lf
tools/build_acplugin.py text eol=lf
src/bin/map2lap.dll binary
